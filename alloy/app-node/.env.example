# Loki push endpoint (central monitoring host).
LOKI_URL=http://<loki-host>:3100/loki/api/v1/push

# Must match the server_name / cluster this host already uses in Prometheus,
# so logs line up with its metrics in Grafana.
SERVER_NAME=my01
CLUSTER=meydan

# Where pm2 writes its per-app logs on THIS host. Common values:
#   /root/.pm2/logs            (pm2 run as root)
#   /home/<user>/.pm2/logs     (pm2 run as a normal user)
# Find it with:  pm2 info <app> | grep 'log path'   (or: ls ~/.pm2/logs)
PM2_LOG_DIR=/root/.pm2/logs
