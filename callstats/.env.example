# CouchDB of this node. Meydan answers on 127.0.0.1:5984 without credentials;
# if a site needs them: http://user:pass@127.0.0.1:5984
COUCH_URL=http://127.0.0.1:5984
# Accounts to count (comma-separated ids). Empty = every account in the "accounts" db.
# Meydan: 544370e9c33f4d679f0f1d37778d3c7c = meydan, 83e47f11c3238e0086fff99a3574e878 = admin
ACCOUNTS=
# rabbitmq_prometheus plugin
RABBIT_URL=http://127.0.0.1:15692
# Bind to the node's private (VPN) IP so the metrics are not on the public interface.
LISTEN=192.168.99.46:9480
POLL_SECONDS=30
# "today" panels reset at local midnight in this offset.
TZ_OFFSET=+04:00
TOP_QUEUES=25
