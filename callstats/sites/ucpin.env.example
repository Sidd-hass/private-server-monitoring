# ucpin: copy to /opt/callstats/.env on ucpin11 (151.243.12.57)
COUCH_URL=http://127.0.0.1:5984
# Customer accounts with call records, not "admin". Fill in on the node:
#   sed -i "s/^ACCOUNTS=.*/ACCOUNTS=$(sh pick_accounts.sh)/" .env
# A new customer account is not counted until its id is added here.
ACCOUNTS=FILL_IN_WITH_pick_accounts.sh
RABBIT_URL=http://127.0.0.1:15692
# Public IP: the firewall must only let 181.214.10.244 (monitoring) reach 9480.
LISTEN=151.243.12.57:9480
POLL_SECONDS=30
TZ_OFFSET=+04:00
TOP_QUEUES=25
