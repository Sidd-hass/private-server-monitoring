# Copy to .env (git-ignored). The three passwords must match config/wazuh_indexer/internal_users.yml
# (hashes) and config/wazuh_dashboard/wazuh.yml, see README.md "Passwords".
# The values below are Wazuh's documented defaults: fine for the local test, NEVER on a server.
WAZUH_VERSION=4.14.11
INDEXER_PASSWORD=SecretPassword
DASHBOARD_PASSWORD=kibanaserver
API_PASSWORD=MyS3cr37P450r.*-

# Resource caps (the server may also run production VoIP)
INDEXER_HEAP=2g
INDEXER_MEM_LIMIT=4g
MANAGER_MEM_LIMIT=2g
DASHBOARD_MEM_LIMIT=1g
DASHBOARD_PORT=5443
# Address the dashboard listens on: 127.0.0.1 locally, 10.20.0.246 on 246 (NPM on 244 reaches it)
DASHBOARD_BIND=127.0.0.1

# Host ports for agents (11514/11515 locally: WSL already runs a native wazuh-manager on 1514/1515)
AGENT_PORT=1514
ENROLL_PORT=1515
API_PORT=55000

# Flock webhooks for level 12+ alerts (same file as Alertmanager). Optional FLOCK_WAZUH=<url> in it
# sends every Wazuh alert to one security channel instead of the cluster channels.
FLOCK_CHANNELS_FILE=../alertmanager/secrets/flock_channels.env
