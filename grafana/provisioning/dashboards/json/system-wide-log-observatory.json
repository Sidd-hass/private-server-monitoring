    {
      "id": 2,
      "title": "Log Rate",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "loki",
        "uid": "Loki"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "Loki"
          },
          "editorMode": "code",
          "expr": "sum(rate({server_name=~\"$server_name\", job=~\"$job\"}[1m]))",
          "queryType": "range",
          "refId": "A"
        }
      ],
      "description": "Log lines per second across the selected hosts and sources.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "#22D3EE"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#22D3EE",
                "value": null
              }
            ]
          },
          "unit": "suffix: /s",
          "decimals": 1,
          "noValue": "0"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "center",
        "orientation": "auto",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
