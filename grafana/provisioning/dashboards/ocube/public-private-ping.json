    {
      "id": 11,
      "type": "table",
      "title": "Public vs Private Diagnostic Matrix",
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "description": "One row per server. Public ping status next to the server's private IP and private ping status, matched on server_name; Private IP is the private probe's instance.",
      "gridPos": {
        "h": 12,
        "w": 24,
        "x": 0,
        "y": 4
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "inspect": false
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "color": "red",
                  "index": 1,
                  "text": "DOWN"
                },
                "1": {
                  "color": "green",
                  "index": 0,
                  "text": "UP"
                }
              }
            },
            {
              "type": "special",
              "options": {
                "match": "null",
                "result": {
                  "color": "gray",
                  "index": 2,
                  "text": "N/A"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Public Ping"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Private Ping"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "cellHeight": "sm",
        "showHeader": true,
        "footer": {
          "countRows": false,
          "fields": "",
          "reducer": [
            "sum"
          ],
          "show": false
        },
        "sortBy": [
          {
            "desc": false,
            "displayName": "Site"
          }
        ]
      },
      "pluginVersion": "10.4.0",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus"
          },
          "editorMode": "code",
          "expr": "max by (server_name, cluster, public_ip) (probe_success{job=\"blackbox_ping_public\",cluster=~\"$cluster\",server_name=~\"$server\"})",
          "refId": "A",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus"
          },
          "editorMode": "code",
          "expr": "max by (server_name, instance) (probe_success{job=\"blackbox_ping\",cluster=~\"$cluster\",server_name=~\"$server\"}) and on(server_name) max by (server_name) (probe_success{job=\"blackbox_ping_public\",cluster=~\"$cluster\",server_name=~\"$server\"})",
          "refId": "B",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "joinByField",
          "options": {
            "byField": "server_name",
            "mode": "outer"
          }
        },
        {
          "id": "filterFieldsByName",
          "options": {
            "include": {
              "names": [
                "cluster",
                "server_name",
                "public_ip",
                "instance",
                "Value #A",
                "Value #B"
              ]
            }
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {},
            "includeByName": {},
            "indexByName": {
              "cluster": 0,
              "server_name": 1,
              "public_ip": 2,
              "instance": 3,
              "Value #A": 4,
              "Value #B": 5
            },
            "renameByName": {
              "cluster": "Site",
              "server_name": "Server",
              "public_ip": "Public IP",
              "instance": "Private IP",
              "Value #A": "Public Ping",
              "Value #B": "Private Ping"
            }
          }
        }
      ]
    },
