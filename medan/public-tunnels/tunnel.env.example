# Install as /etc/default/medan-public-tunnels on the central Docker host.
# Must equal the host-gateway address resolved for host.docker.internal
# inside the Prometheus container. 172.17.0.1 is Docker's common default.
TUNNEL_BIND=172.17.0.1
SSH_KEY=/etc/ssh/monitoring-medan
SSH_KNOWN_HOSTS=/etc/ssh/ssh_known_hosts
