# Copy to voip/gateway/.env on 244 (git-ignored).
# Trunk node agents, reached over the VPN: cluster/node=url, comma separated.
AGENTS=meydan/my03=http://192.168.99.42:9479
# Same secret as AGENT_TOKEN in the agent's .env on the node. Generate: openssl rand -hex 32
AGENT_TOKEN=change-me
# Path served on the Grafana domain (nginx-proxy-manager custom location).
BASE_PATH=/voip
