# Dubai South trunk node ds02 (du_ae_trunk 044967600). Copy to /opt/voip-agent/.env on ds02.
# --- what to capture
# Trunk interface: ds02 ens19 (ds01's ens19 is down, ds01 is standby).
IFACE=ens19
# UDP ports carrying SIP on IFACE. Check with the tcpdump in voip/README.md before starting.
SIP_PORTS=5060

# --- labels (match prometheus/targets/debian_servers.json)
CLUSTER=dubai_south
SERVER_NAME=ds02

# --- RAM only, nothing on disk
# ds02 ens19 peaks at ~230 RTP packets/s received (my03: ~760): 1024 MB keeps roughly 2-3 h of calls.
RING_MB=1024
MEM_LIMIT=1600m
RECENT_CALLS=2000

# --- API + metrics (reached from 244 over the VPN; bind to the node's private IP)
LISTEN=192.168.160.7:9479
# Same AGENT_TOKEN as Meydan my03 and voip/gateway/.env on 244 (the gateway uses one token for all agents).
AGENT_TOKEN=change-me

# --- Loki (Alloy receiver on 244 through the VPN): finished calls + SIP messages, kept 48 h
LOKI_URL=http://10.200.26.4:3500/loki/api/v1/push
LOG_OPTIONS=false
