# --- what to capture
# Trunk interface. Meydan: my03 ens19 (10.15.228.226/30, the link to du).
IFACE=ens19
# UDP ports carrying SIP on IFACE (du trunk: 5060).
SIP_PORTS=5060

# --- labels (match prometheus/targets/debian_servers.json)
CLUSTER=meydan
SERVER_NAME=my03

# --- RAM only, nothing on disk
# RTP ring buffer (real RAM). my03 ens19 runs ~700 RTP packets/s: 1024 MB keeps ~45 min of calls, 2048 ~90 min.
RING_MB=1024
# Container memory cap: RING_MB + ~50% for Python overhead.
MEM_LIMIT=1600m
# Finished calls kept in the call list (metadata only).
RECENT_CALLS=2000

# --- API + metrics (reached from 244 over the VPN; bind to the node's private IP)
LISTEN=192.168.99.42:9479
# Shared secret with voip-gateway on 244 (same value in voip/gateway/.env). Generate: openssl rand -hex 32
AGENT_TOKEN=change-me

# --- Loki (Alloy receiver on 244 through the VPN): finished calls + SIP messages, kept 48 h
LOKI_URL=http://10.200.26.4:3500/loki/api/v1/push
LOG_OPTIONS=false

