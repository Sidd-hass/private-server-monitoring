# Copy to alertmanager/secrets/flock_channels.env (git-ignored) and fill in the
# Flock incoming webhook URL for each cluster channel (Flock > Apps > Incoming Webhook).
# The key is FLOCK_ + the cluster label in upper case; alertmanager.yml routes
# cluster="ucpin" to http://flock-relay:9099/ucpin, which uses FLOCK_UCPIN.
FLOCK_UCPIN=https://api.flock.com/hooks/sendMessage/<id>
FLOCK_UCDEMO=https://api.flock.com/hooks/sendMessage/<id>
FLOCK_UCPMED=https://api.flock.com/hooks/sendMessage/<id>
FLOCK_MULTICOMM=https://api.flock.com/hooks/sendMessage/<id>
FLOCK_MEYDAN=https://api.flock.com/hooks/sendMessage/<id>
FLOCK_SHAMS=https://api.flock.com/hooks/sendMessage/<id>
FLOCK_DUBAI_SOUTH=https://api.flock.com/hooks/sendMessage/<id>
FLOCK_SPC=https://api.flock.com/hooks/sendMessage/<id>

# Times in messages (default UTC). Example for Gulf time:
# DISPLAY_TZ=+04:00
# DISPLAY_TZ_NAME=GST
